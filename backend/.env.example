# NCTB Intelligence Demo - Backend Environment Configuration

APP_NAME=NCTB Intelligence Demo
DEBUG=false
API_V1_PREFIX=/api/v1

# SQLite database connection string (resolved relative to project root if relative path is provided)
DATABASE_URL=sqlite+aiosqlite:///./data/nctb_intelligence.db

# CORS Allowed Origins - formatted as a JSON array of strings or comma-separated URLs
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174", "http://localhost:5175", "http://127.0.0.1:5175", "http://localhost:3000", "http://127.0.0.1:3000"]

# Local file storage root directory (resolved relative to project root if relative path is provided)
STORAGE_ROOT=./storage

# Primary LLM Configuration (Groq)
LLM_PROVIDER=groq
LLM_PRIMARY_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Fallback LLM Configuration (OpenRouter)
LLM_FALLBACK_PROVIDER=openrouter
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=

# Failover & Rate Limit Tolerances
LLM_MAX_AUTO_RETRY_WAIT_SECONDS=8.0
LLM_PROVIDER_ATTEMPT_TIMEOUT_SECONDS=30.0
LLM_TOTAL_GENERATION_TIMEOUT_SECONDS=120.0

# General LLM Settings
LLM_REASONING_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=60.0

# LLM Token & Rate Budget Configuration
LLM_TPM_LIMIT=8000
LLM_REQUEST_TOKEN_TARGET=2800
LLM_OUTPUT_TOKEN_RESERVE=1500
LLM_RATE_LIMIT_SAFETY_RATIO=0.85

# Optional Assessment Limits Override (empty = no explicit limit)
MCQ_MAX_TOTAL_QUESTIONS=
